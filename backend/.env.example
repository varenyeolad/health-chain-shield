# Backend
PORT=3001
NODE_ENV=development

# Prisma/PostgreSQL
DATABASE_URL=postgresql://medchain:medchain@localhost:5433/medchain
# Set true to boot backend without DB connection (for UI/API smoke checks)
PRISMA_SKIP_CONNECT=false

# Redis / Jobs
REDIS_URL=redis://localhost:6379

# S3 / MinIO
S3_ENDPOINT=localhost
S3_PORT=9000
S3_SSL=false
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
RECORDS_BUCKET=medchain-records

# Fabric mode: mock|fabric
FABRIC_MODE=mock

# KMS prototype seed (change in prod)
KMS_MASTER_SEED=dev-seed-change-in-prod
