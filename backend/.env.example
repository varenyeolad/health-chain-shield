# Backend
PORT=3001
NODE_ENV=development

# Prisma/PostgreSQL
DATABASE_URL=postgresql://medchain:medchain@localhost:5433/medchain
# Set true to boot backend without DB connection (for UI/API smoke checks)
PRISMA_SKIP_CONNECT=false

# Redis / Jobs
REDIS_URL=redis://localhost:6379

# S3 / MinIO
S3_ENDPOINT=localhost
S3_PORT=9000
S3_SSL=false
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
RECORDS_BUCKET=medchain-records

# Fabric mode: mock|fabric
FABRIC_MODE=mock

# KMS prototype seed (change in prod)
KMS_MASTER_SEED=dev-seed-change-in-prod

# Required when FABRIC_MODE=fabric (from the official test-network identities)
FABRIC_PEER_ENDPOINT=localhost:7051
FABRIC_PEER_HOST_ALIAS=peer0.org1.example.com
FABRIC_MSP_ID=Org1MSP
FABRIC_CHANNEL=healthchannel
FABRIC_CHAINCODE=healthchain
FABRIC_TLS_CERT_PATH=/absolute/path/to/peer0.org1.example.com/tls/ca.crt
FABRIC_CERT_PATH=/absolute/path/to/User1@org1.example.com/msp/signcerts/cert.pem
FABRIC_KEY_PATH=/absolute/path/to/User1@org1.example.com/msp/keystore/priv_sk

# Research-only live Fabric benchmark bridge (disabled by default)
ENABLE_BENCHMARK_API=false
BENCHMARK_API_TOKEN=replace-with-a-random-32-character-token
